APP_NAME=Laravel
APP_ENV=production
APP_KEY=
# Debug flags MUST stay disabled in production (ISO 27002:8.28 secure coding).
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Avoid verbose stack traces in production logs (ISO 27002:8.28).
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lumina_rag
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# RAG Configuration
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_BASE_URL=http://localhost:11434
RAG_EMBEDDING_MODEL=text-embedding-ada-002
RAG_EMBEDDING_DIMENSIONS=1536
RAG_EMBEDDING_BATCH_SIZE=100
RAG_EMBEDDING_CACHE_TTL=86400
RAG_EMBEDDING_TIMEOUT=30

RAG_LLM_PROVIDER=openai
RAG_LLM_BASE_URL=http://localhost:11434
RAG_LLM_MODEL=gpt-4o
RAG_LLM_TEMPERATURE=0.3
RAG_LLM_MAX_CONTEXT_TOKENS=4000
RAG_LLM_TIMEOUT=60

RAG_VECTOR_DRIVER=pgsql
RAG_VECTOR_INDEX_LISTS=100

RAG_SEARCH_TOP_K=5
RAG_SEARCH_SIMILARITY_THRESHOLD=0.65
RAG_QUERY_REWRITER_ENABLED=true
RAG_QUERY_REWRITER_COMPLEXITY_THRESHOLD=5

RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

RAG_MAX_QUESTION_LENGTH=1000
RAG_MAX_MESSAGES_PER_SESSION=100

# Security (ISO 27002:5.15, 8.24, 8.6)
# Chat endpoint requests per minute per client IP.
RAG_CHAT_MAX_REQUESTS_PER_MINUTE=20
# Restrict retrieval to the authenticated user's own documents.
RAG_TENANT_ISOLATION=true
# API token lifetime in days; null/omitted for no expiry (weakest option).
RAG_API_TOKEN_TTL_DAYS=30

# Pagination (client can request any per_page; server caps at max_per_page)
RAG_PAGINATION_PER_PAGE=20
RAG_PAGINATION_MAX_PER_PAGE=100

OPENAI_API_KEY=

# Additional LLM Provider API Keys
GEMINI_API_KEY=
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
